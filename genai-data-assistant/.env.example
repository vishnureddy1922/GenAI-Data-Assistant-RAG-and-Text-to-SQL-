# openai or bedrock
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Amazon Bedrock (uses your AWS credentials: profile, SSO or instance role)
AWS_REGION=us-east-1
BEDROCK_CHAT_MODEL=anthropic.claude-3-5-haiku-20241022-v1:0
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# Local runs outside Docker
DATABASE_URL=postgresql+psycopg://assistant:assistant@localhost:5432/assistant
READONLY_DATABASE_URL=postgresql+psycopg://assistant_ro:assistant_ro@localhost:5432/assistant

SQL_MAX_ROWS=200
SQL_TIMEOUT_MS=5000
RETRIEVAL_K=4

# Protects POST /ingest (leave empty to disable the check locally)
API_KEY=
